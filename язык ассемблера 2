Метка - просто имя для некоторого адресса
---------------------------------------------
1. Адресс данных
vallue:              
       quad 42  
2. Адресс кода
add42: 
      movq %rdi, %rax
      addq vallue, %rax
      retq
-ПРИМЕР
section .data
    message:    db "Hello", 0    ; метка для данных
    array:      dw 1,2,3,4      ; метка для массива

section .text
    global _start
_start:                         ; метка для кода (точка входа)
    mov eax, [array]            ; обращение по метке
    cmp eax, 0
    jz  exit                    ; переход по метке exit
exit:                           ; ещё одна метка
    mov eax, 1                  ; системный вызов exit
    int 0x80
